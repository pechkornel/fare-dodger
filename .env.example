# Copy to .env and fill in. Never commit .env.

# Your user and group (`id -u`, `id -g`), so the container can write ./data.
PUID=1000
PGID=1000

# Where the game listens on the host: 0.0.0.0 for your LAN, 127.0.0.1 for the tunnel only.
GAME_BIND=0.0.0.0
GAME_MEMORY=1536m

# Safety caps for a public server.
FARE_DODGER_MAX_MATCHES=20
FARE_DODGER_MAX_MATCHES_PER_IP=2
FARE_DODGER_IDLE_S=120

# The admin page (https://<your host>/admin): a long random password turns it on.
# Make one with: openssl rand -hex 24
FARE_DODGER_ADMIN_TOKEN=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token after `--token`.
# The tunnel's public hostname should point at http://game:8001.
CLOUDFLARE_TUNNEL_TOKEN=
